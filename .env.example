NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
AI_ENABLED=false
# Enable after choosing a current Gateway model, configuring a budget, and testing.
AI_GATEWAY_MODEL=
# Vercel uses OIDC automatically. Local development needs a server-only key.
AI_GATEWAY_API_KEY=
# Configure Resend as Supabase custom SMTP; never put its key in NEXT_PUBLIC variables.
